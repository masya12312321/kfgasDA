# Telegram
BOT_TOKEN=123456:ABC-your-token
# comma-separated chat ids that receive alerts (channel or user ids)
ALERT_CHAT_IDS=

# Runtime
MODE=LIVE            # LIVE | PAPER | BACKTEST | DEBUG
LOG_LEVEL=INFO

# Bybit (public data only, keys not required for scanning)
BYBIT_BASE=https://api.bybit.com
BYBIT_WS=wss://stream.bybit.com/v5/public/linear

# Database
DB_PATH=data/signals.db

# Optional Redis ("memory" = in-process cache)
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
